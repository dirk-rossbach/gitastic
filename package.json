{
  "name": "gitastic",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Gitastic is a fast, cross-platform visual Git client for macOS, Windows and Linux with a branch graph, partial staging, conflict resolution and GitHub/GitLab integration.",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "bin": {
    "gitastic": "apps/server/dist/cli.js"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @gitastic/server\" \"npm run dev -w @gitastic/web\"",
    "build": "npm run build -w @gitastic/web && npm run build -w @gitastic/server",
    "start": "node apps/server/dist/cli.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
