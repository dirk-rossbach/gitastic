{
  "name": "gitastic",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "Gitastic is a fast, cross-platform visual Git client for macOS, Windows and Linux with a branch graph, partial staging, conflict resolution and GitHub/GitLab integration.",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "@fastify/static": {
      "glob": "^14.0.3"
    },
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  },
  "bin": {
    "gitastic": "apps/server/dist/cli.js"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @gitastic/server\" \"npm run dev -w @gitastic/web\"",
    "build": "npm run build -w @gitastic/web && npm run build -w @gitastic/server",
    "start": "node apps/server/dist/cli.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "licenses": "node scripts/generate-third-party-licenses.mjs",
    "typecheck": "tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.13.0",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
