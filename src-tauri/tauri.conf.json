{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gitastic",
  "version": "1.2.0",
  "identifier": "com.gitastic.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @gitastic/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @gitastic/web",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Gitastic",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
